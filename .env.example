# ==========================================
# KONFIGURASI BOT TELEGRAM & LLM
# Salin file ini menjadi .env lalu isi nilainya
# ==========================================

# 1. Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Telegram Chat ID Pemilik Toko (dapatkan dengan ketik /id di bot)
OWNER_CHAT_ID=your_chat_id_here

# 3. Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 4. Groq API Key sebagai LLM Cadangan (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
